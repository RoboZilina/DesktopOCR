/* ===== Global ===== */
* {
    background-color: {BG};
    color: {TEXT};
    font-family: "Segoe UI", sans-serif;
}

/* ===== Panels ===== */
QWidget#SideMenu,
QWidget#HistorySidebar,
QWidget#StatusBar,
QWidget#PreviewWidget,
QWidget#TranscriptionTray {
    background-color: {PANEL};
    border: 1px solid {BORDER};
}

/* ===== Labels ===== */
QLabel {
    color: {TEXT};
}

QLabel[dim="true"] {
    color: {TEXT_DIM};
}

QLabel[secondary="true"] {
    color: {TEXT_SECONDARY};
}

/* UNIVERSAL BUTTON STYLE */
QPushButton,
QToolButton,
QWidget[role="button"] {
    background-color: {PANEL};
    border: 1px solid {BORDER};
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 28px;
}

QPushButton:hover,
QToolButton:hover,
QWidget[role="button"]:hover {
    background-color: {HOVER};
    border-color: {ACCENT};
}

QPushButton:pressed,
QToolButton:pressed,
QWidget[role="button"]:pressed {
    background-color: {PRESSED};
    border-color: {ACCENT_DARK};
}

QPushButton:checked,
QToolButton:checked,
QWidget[role="button"][checked="true"] {
    background-color: {ACCENT};
    color: white;
    border-color: {ACCENT};
}

QPushButton:disabled,
QToolButton:disabled,
QWidget[role="button"]:disabled {
    background-color: {DISABLED_BG};
    color: {DISABLED_FG};
    border-color: {DISABLED_BORDER};
}

/* ===== Checkboxes ===== */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid {BORDER};
    background: {PANEL};
}

QCheckBox::indicator:checked {
    background: {ACCENT};
    border-color: {ACCENT};
}

/* ===== Sliders ===== */
QSlider::groove:horizontal {
    height: 6px;
    background: {BORDER};
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: {ACCENT};
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: {PANEL};
    width: 10px;
}

QScrollBar::handle:vertical {
    background: {ACCENT};
    border-radius: 4px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
}

/* Prevent labels from drawing background rectangles */
QLabel {
    background: transparent;
}

/* 
   Remove background from ALL header-like widgets.
   This covers QLabel, QFrame, QWidget, and any auto-created container.
   It also removes borders that might create a "box" effect.
*/

QWidget[role="header"],
QFrame[role="header"],
QWidget[role="section-header"],
QFrame[role="section-header"],
QWidget[role="title"],
QFrame[role="title"],
QWidget[role="panel-header"],
QFrame[role="panel-header"],
QWidget#section_header,
QFrame#section_header,
QWidget#header,
QFrame#header,
QWidget#title,
QFrame#title {
    background: transparent;
    border: none;
}

/* 
   Also remove background from ANY widget that contains only a label 
   and is used as a header, even if it has no objectName.
   This is the universal fallback.
*/
